    "@tamagui/core": "1.144.3",
    "@tamagui/font-inter": "1.144.3",
    "@tamagui/lucide-icons": "1.144.3",
    "tamagui": "1.144.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3"
  }
